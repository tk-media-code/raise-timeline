<?xml version="1.0" encoding="UTF-8"?>
<!--
  SpotBugsの検出結果から、意図的に除外するバグパターンを定義するファイル。

  EI_EXPOSE_REP / EI_EXPOSE_REP2（「内部表現の露出」）を除外している。これらは
  「getterがミュータブルなフィールドをそのまま返す」「コンストラクタ/setterが受け取った引数を
  そのままフィールドへ格納する」ことを指摘するルール。

  Spring Boot + JPA のふつうの書き方は、ほぼすべてこの指摘に当たる：
    1. コンストラクタインジェクション。SpringがDIコンテナで管理するBean（JdbcTemplateなど）を
       受け取ってフィールドに持つのが前提で、コピーを作るものではない。
    2. JPAエンティティの関連（@ManyToOne等）。防御的コピーを挟むと、同一性比較や変更検知が
       意図通り働かなくなる。
    3. DTOのrecord。コンストラクタ引数をそのままフィールドにするのが標準的な使い方。
  除外せずに残すと、実際のバグの指摘がノイズに埋もれるため、ここで除外する。
-->
<FindBugsFilter>
	<Match>
		<Bug pattern="EI_EXPOSE_REP" />
	</Match>
	<Match>
		<Bug pattern="EI_EXPOSE_REP2" />
	</Match>
</FindBugsFilter>
